# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:kalpesh2005%3F@127.0.0.1:5432/gunny_db

# TSC thermal printer (Ethernet)
PRINTER_IP=192.168.1.75
PRINTER_PORT=9100

# Weighing scale (Modbus RTU over USB-serial, e.g. COM7)
# Default values match the working setup in C:\AtharvProject
SCALE_DRIVER=modbus
SCALE_PORT=COM7
SCALE_BAUD_RATE=9600
SCALE_SLAVE_ID=1
SCALE_REGISTER=0
SCALE_QUANTITY=1
SCALE_REGISTER_FORMAT=u16
SCALE_DIVISOR=1000
SCALE_POLL_MS=1000
SCALE_RECONNECT_MS=5000
# Set to "false" to disable mock readings when the scale is offline
SCALE_MOCK=true

# Compound Inventory login
COMPOUND_INVENTORY_USERNAME=admin
COMPOUND_INVENTORY_PASSWORD=change-this-password
COMPOUND_INVENTORY_SESSION_SECRET=replace-with-a-long-random-secret
